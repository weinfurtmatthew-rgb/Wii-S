<?xml version="1.0" encoding="utf-8"?>
<!-- The RetroAchievements username and Web API key stay on this device: never in backups or transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wiis_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wiis_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
