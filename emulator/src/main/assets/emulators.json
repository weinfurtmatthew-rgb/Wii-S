{
  "version": 1,
  "notes": "Cross-checked against ES-DE's Android find rules. All 11 activities resolved on a Thor Max (spike 2026-11-13); verified=true means a game was actually launched.",
  "emulators": [
    {
      "id": "retroarch",
      "name": "RetroArch",
      "targets": [
        {
          "package": "com.retroarch.aarch64",
          "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture"
        },
        {
          "package": "com.retroarch.ra32",
          "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture"
        },
        {
          "package": "com.retroarch",
          "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture"
        }
      ],
      "launch": {
        "action": "android.intent.action.MAIN",
        "extras": {
          "CONFIGFILE": "{externalData}/Android/data/{pkg}/files/retroarch.cfg",
          "LIBRETRO": "{internalData}/{pkg}/cores/{core}_libretro_android.so",
          "ROM": "{rom.path}"
        }
      },
      "control": {
        "type": "retroarch_udp",
        "port": 55355
      }
    },
    {
      "id": "dolphin",
      "verified": true,
      "name": "Dolphin",
      "targets": [
        {
          "package": "org.dolphinemu.dolphinemu",
          "activity": "org.dolphinemu.dolphinemu.ui.main.TvMainActivity"
        }
      ],
      "launch": {
        "action": "android.intent.action.MAIN",
        "category": "android.intent.category.LEANBACK_LAUNCHER",
        "extras": {
          "AutoStartFile": "{rom.uri}"
        }
      }
    },
    {
      "id": "ppsspp",
      "name": "PPSSPP",
      "targets": [
        {
          "package": "org.ppsspp.ppssppgold",
          "activity": "org.ppsspp.ppsspp.PpssppActivity"
        },
        {
          "package": "org.ppsspp.ppsspp",
          "activity": "org.ppsspp.ppsspp.PpssppActivity"
        }
      ],
      "launch": {
        "action": "android.intent.action.VIEW",
        "category": "android.intent.category.DEFAULT",
        "data": "{rom.uri}"
      }
    },
    {
      "id": "duckstation",
      "name": "DuckStation",
      "targets": [
        {
          "package": "com.github.stenzek.duckstation",
          "activity": "com.github.stenzek.duckstation.EmulationActivity"
        }
      ],
      "launch": {
        "flags": [
          "CLEAR_TASK",
          "CLEAR_TOP"
        ],
        "boolExtras": {
          "resumeState": false
        },
        "extras": {
          "bootPath": "{rom.uri}"
        }
      }
    },
    {
      "id": "cemu",
      "name": "Cemu",
      "targets": [
        {
          "package": "info.cemu.cemu",
          "activity": "info.cemu.cemu.emulation.EmulationActivity"
        },
        {
          "package": "info.cemu.Cemu",
          "activity": "info.cemu.Cemu.emulation.EmulationActivity"
        }
      ],
      "launch": {
        "data": "{rom.uri}"
      }
    },
    {
      "id": "azahar",
      "name": "Azahar",
      "targets": [
        {
          "package": "org.azahar_emu.azahar",
          "activity": "org.citra.citra_emu.activities.EmulationActivity"
        },
        {
          "package": "io.github.azaharplus.android",
          "activity": "org.citra.citra_emu.activities.EmulationActivity"
        },
        {
          "package": "io.github.lime3ds.android",
          "activity": "org.citra.citra_emu.activities.EmulationActivity"
        }
      ],
      "launch": {
        "flags": [
          "CLEAR_TASK",
          "CLEAR_TOP"
        ],
        "data": "{rom.uri}"
      },
      "usesBothScreens": true
    },
    {
      "id": "eden",
      "name": "Eden",
      "targets": [
        {
          "package": "dev.eden.eden_emulator",
          "activity": "org.yuzu.yuzu_emu.activities.EmulationActivity"
        },
        {
          "package": "dev.legacy.eden_emulator",
          "activity": "org.yuzu.yuzu_emu.activities.EmulationActivity"
        },
        {
          "package": "dev.eden.eden_emulator.nightly",
          "activity": "org.yuzu.yuzu_emu.activities.EmulationActivity"
        }
      ],
      "launch": {
        "action": "android.nfc.action.TECH_DISCOVERED",
        "data": "{rom.uri}"
      }
    },
    {
      "id": "gamenative",
      "name": "GameNative",
      "targets": [
        {
          "package": "app.gamenative",
          "activity": "app.gamenative.MainActivity"
        }
      ],
      "launch": {
        "action": "app.gamenative.LAUNCH_GAME",
        "extras": {
          "game_source": "STEAM"
        },
        "intExtras": {
          "app_id": "{rom.contents}"
        }
      }
    },
    {
      "id": "melonds",
      "name": "melonDS",
      "targets": [
        {
          "package": "me.magnum.melonds",
          "activity": "me.magnum.melonds.ui.emulator.EmulatorActivity"
        },
        {
          "package": "me.magnum.melondualds",
          "activity": "me.magnum.melonds.ui.emulator.EmulatorActivity"
        },
        {
          "package": "me.magnum.melonds.nightly",
          "activity": "me.magnum.melonds.ui.emulator.EmulatorActivity"
        }
      ],
      "launch": {
        "action": "me.magnum.melonds.LAUNCH_ROM",
        "extras": {
          "uri": "{rom.uri}"
        }
      },
      "usesBothScreens": true
    },
    {
      "id": "nethersx2",
      "verified": true,
      "name": "NetherSX2",
      "targets": [
        {
          "package": "xyz.aethersx2.android",
          "activity": "xyz.aethersx2.android.EmulationActivity"
        },
        {
          "package": "xyz.aethersx2.tturnip",
          "activity": "xyz.aethersx2.android.EmulationActivity"
        },
        {
          "package": "xyz.aethersx2.cturnip",
          "activity": "xyz.aethersx2.android.EmulationActivity"
        }
      ],
      "launch": {
        "action": "android.intent.action.MAIN",
        "flags": [
          "CLEAR_TASK",
          "CLEAR_TOP"
        ],
        "extras": {
          "bootPath": "{rom.uri}"
        }
      }
    },
    {
      "id": "xendroid",
      "verified": true,
      "name": "XenDroid",
      "targets": [
        {
          "package": "xendroid.compose",
          "activity": "xendroid.compose.EmulatorHostActivity"
        }
      ],
      "launch": {
        "data": "{rom.uri}"
      }
    }
  ],
